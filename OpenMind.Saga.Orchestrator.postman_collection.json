			"name": "Orchestrator",
			"description": "Order Placement Orchestrator API - manages the Axon saga workflow",
			"item": [
				{
					"name": "Place Order (Start Saga)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Order placement accepted\", function () {",
									"    pm.response.to.have.status(202);",
									"});",
									"",
									"if (pm.response.code === 202) {",
									"    var jsonData = pm.response.json();",
									"    pm.test(\"Response echoes orderId\", function () {",
									"        pm.expect(jsonData.orderId).to.not.be.null;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{orchestrator_url}}/api/sagas/orders/{{order_id}}/place",
							"host": [
								"{{orchestrator_url}}"
							],
							"path": [
								"api",
								"sagas",
								"orders",
								"{{order_id}}",
								"place"
							]
						},
						"description": "Publishes a PlaceOrderCommand to the order-commands SNS topic, the same path any other saga input takes. This starts (or, if the saga is in ValidationFailed, retries) the OrderPlacementSaga for the given order, which then coordinates with Payment, Fulfillment, and Email services."

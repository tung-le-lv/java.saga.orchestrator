{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "OpenMind Saga Orchestrator",
		"description": "Postman collection for testing the OpenMind Saga Orchestrator microservices (Java/Spring Boot port).\n\nDefault variable values below match running each service locally without Docker (application-dev.yml / the `dev` profile). If you're using `docker compose up` instead, change the `*_url` variables to ports 5000 (orchestrator), 5001 (order), 5002 (payment), 5003 (fulfillment), 5004 (email).\n\n## Services\n- **Orchestrator** (Port 8095): Axon-managed saga that coordinates the order placement workflow\n- **Order** (Port 8091): Manages order creation and storage, and triggers the placement saga\n- **Payment** (Port 8092): Handles payment processing (simulated gateway) + manual retry\n- **Fulfillment** (Port 8093): Manages order fulfillment and shipping (simulated warehouse)\n- **Email** (Port 8094): Sends notification emails (simulated, stateless)\n\n## Workflow\n1. First create an order using \"Create Order\" in the Order Service\n2. Then use Order Service's \"Place Order (Start Saga)\" to initiate the placement process\n3. Poll Orchestrator's \"Get Saga State\" to watch the saga move through states (it's removed from the store once it ends, so a 404 there means it already completed/cancelled)\n4. Check \"Get Order\" / \"Get Payment\" / \"Get Fulfillment\" for each service's own view\n5. If the saga parks in `PaymentNotPaid`, use Payment Service's \"Retry Payment\" to unblock it",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "orchestrator_url",
			"value": "http://localhost:8095",
			"type": "string"
		},
		{
			"key": "order_url",
			"value": "http://localhost:8091",
			"type": "string"
		},
		{
			"key": "payment_url",
			"value": "http://localhost:8092",
			"type": "string"
		},
		{
			"key": "fulfillment_url",
			"value": "http://localhost:8093",
			"type": "string"
		},
		{
			"key": "email_url",
			"value": "http://localhost:8094",
			"type": "string"
		},
		{
			"key": "order_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "customer_id",
			"value": "{{$guid}}",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Orchestrator",
			"description": "Order Placement Orchestrator API - manages the Axon saga workflow. Not exposed to clients directly; the saga is triggered indirectly via the Order service's \"Place Order\" endpoint.",
			"item": [
				{
					"name": "Get Saga State",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.test(\"Response has saga state\", function () {",
									"        var jsonData = pm.response.json();",
									"        pm.expect(jsonData.orderId).to.not.be.null;",
									"        pm.expect(jsonData.currentState).to.not.be.null;",
									"    });",
									"} else {",
									"    console.log(\"Saga not found (404) - it has likely already completed/cancelled and been removed from the store, or hasn't started yet.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{orchestrator_url}}/api/sagas/orders/{{order_id}}",
							"host": [
								"{{orchestrator_url}}"
							],
							"path": [
								"api",
								"sagas",
								"orders",
								"{{order_id}}"
							]
						},
						"description": "Retrieves the current in-flight saga state (currentState, payment/fulfillment ids, tracking number, last error, ...). Returns 404 once the saga has ended (Completed/Cancelled) - Axon removes ended sagas from the store - so check Order/Payment/Fulfillment's own endpoints for the final outcome."
					},
					"response": [
						{
							"name": "Saga State - In Progress",
							"originalRequest": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{orchestrator_url}}/api/sagas/orders/{{order_id}}",
									"host": [
										"{{orchestrator_url}}"
									],
									"path": [
										"api",
										"sagas",
										"orders",
										"{{order_id}}"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"orderId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"correlationId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"customerId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n    \"totalAmount\": 2699.97,\n    \"currentState\": \"Fulfilling\",\n    \"trackingNumber\": null,\n    \"lastError\": null,\n    \"createdAt\": \"2026-01-13T10:00:00Z\",\n    \"updatedAt\": \"2026-01-13T10:00:02Z\",\n    \"completedAt\": null\n}"
						}
					]
				}
			]
		},
		{
			"name": "Order Service",
			"description": "Order Service API - manages order entities",
			"item": [
				{
					"name": "Create Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"order_id\", jsonData.orderId);",
									"    pm.test(\"Order created successfully\", function () {",
									"        pm.expect(jsonData.orderId).to.not.be.null;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customerId\": \"{{$guid}}\",\n    \"items\": [\n        {\n            \"productId\": \"{{$guid}}\",\n            \"productName\": \"iPhone 15 Pro\",\n            \"quantity\": 1,\n            \"unitPrice\": 1199.99\n        },\n        {\n            \"productId\": \"{{$guid}}\",\n            \"productName\": \"AirPods Pro\",\n            \"quantity\": 1,\n            \"unitPrice\": 249.99\n        }\n    ],\n    \"shippingAddress\": {\n        \"street\": \"456 Innovation Ave\",\n        \"city\": \"Seattle\",\n        \"state\": \"WA\",\n        \"zipCode\": \"98101\",\n        \"country\": \"USA\"\n    }\n}"
						},
						"url": {
							"raw": "{{order_url}}/api/orders",
							"host": [
								"{{order_url}}"
							],
							"path": [
								"api",
								"orders"
							]
						},
						"description": "Creates a new order in the Order service. After creating an order, use \"Place Order (Start Saga)\" below to initiate the saga workflow."
					},
					"response": []
				},
				{
					"name": "Place Order (Start Saga)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Order placement accepted\", function () {",
									"    pm.response.to.have.status(202);",
									"});",
									"",
									"if (pm.response.code === 202) {",
									"    var jsonData = pm.response.json();",
									"    pm.test(\"Response echoes orderId\", function () {",
									"        pm.expect(jsonData.orderId).to.not.be.null;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{order_url}}/api/orders/{{order_id}}/place",
							"host": [
								"{{order_url}}"
							],
							"path": [
								"api",
								"orders",
								"{{order_id}}",
								"place"
							]
						},
						"description": "Publishes a PlaceOrderCommand to the order-commands SNS topic. This starts (or, if the saga is in ValidationFailed, retries) the OrderPlacementSaga for the given order in the Orchestrator, which then coordinates with Payment, Fulfillment, and Email services."
					},
					"response": [
						{
							"name": "Order Accepted",
							"originalRequest": {
								"method": "POST",
								"header": [],
								"url": {
									"raw": "{{order_url}}/api/orders/3fa85f64-5717-4562-b3fc-2c963f66afa6/place",
									"host": [
										"{{order_url}}"
									],
									"path": [
										"api",
										"orders",
										"3fa85f64-5717-4562-b3fc-2c963f66afa6",
										"place"
									]
								}
							},
							"status": "Accepted",
							"code": 202,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"orderId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\"\n}"
						}
					]
				},
				{
					"name": "Get Order by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{order_url}}/api/orders/{{order_id}}",
							"host": [
								"{{order_url}}"
							],
							"path": [
								"api",
								"orders",
								"{{order_id}}"
							]
						},
						"description": "Retrieves an order by its ID from the Order service."
					},
					"response": []
				}
			]
		},
		{

				},
				{
					"name": "Retry Payment",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Retry accepted\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{payment_url}}/api/payments/order/{{order_id}}/retry",
							"host": [
								"{{payment_url}}"
							],
							"path": [
								"api",
								"payments",
								"order",
								"{{order_id}}",
								"retry"
							]
						},
						"description": "Forces the latest (failed) payment attempt for an order to succeed and publishes PaymentCompletedEvent - unblocks a saga instance parked in PaymentNotPaid. Only works if the order's payment is currently Failed."
					},
					"response": []
				}
			]
		},

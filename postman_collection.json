		{
			"name": "End-to-End Test",
			"description": "Complete order placement workflow test",
			"item": [
				{
					"name": "1. Create Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Order created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"order_id\", jsonData.orderId);",
									"    console.log(\"Order ID: \" + jsonData.orderId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"customerId\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n    \"items\": [\n        {\n            \"productId\": \"f1e2d3c4-b5a6-7890-1234-567890abcdef\",\n            \"productName\": \"Test Product\",\n            \"quantity\": 2,\n            \"unitPrice\": 99.99\n        }\n    ],\n    \"shippingAddress\": {\n        \"street\": \"789 Test Lane\",\n        \"city\": \"Test City\",\n        \"state\": \"TX\",\n        \"zipCode\": \"75001\",\n        \"country\": \"USA\"\n    }\n}"
						},
						"url": {
							"raw": "{{order_url}}/api/orders",
							"host": [
								"{{order_url}}"
							],
							"path": [
								"api",
								"orders"
							]
						},
						"description": "Step 1: Create a new order in the Order Service"
					},
					"response": []
				},
				{
					"name": "2. Place Order (Start Saga)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Order accepted\", function () {",
									"    pm.response.to.have.status(202);",
									"});",
									"",
									"if (pm.response.code === 202) {",
									"    var jsonData = pm.response.json();",
									"    console.log(\"Order placement initiated for: \" + jsonData.orderId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{order_url}}/api/orders/{{order_id}}/place",
							"host": [
								"{{order_url}}"
							],
							"path": [
								"api",
								"orders",
								"{{order_id}}",
								"place"
							]
						},
						"description": "Step 2: Initiate the placement saga for the created order"
					},
					"response": []
				},
				{
					"name": "3. Check Saga State (while in progress)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    console.log(\"Current State: \" + jsonData.currentState);",
									"",
									"    var validStates = [\"Validating\", \"ValidationFailed\", \"PaymentProcessing\", \"PaymentNotPaid\", \"Fulfilling\", \"SendingConfirmation\", \"RefundingPayment\", \"SendingBackorderEmail\", \"SendingRefundEmail\"];",
									"    pm.test(\"Saga has a valid in-progress state\", function () {",
									"        pm.expect(validStates).to.include(jsonData.currentState);",
									"    });",
									"} else {",
									"    console.log(\"Saga already ended (404) - check Order/Payment/Fulfillment status instead.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{orchestrator_url}}/api/sagas/orders/{{order_id}}",
							"host": [
								"{{orchestrator_url}}"
							],
							"path": [
								"api",
								"sagas",
								"orders",
								"{{order_id}}"
							]
						},
						"description": "Step 3: Check saga state shortly after placing the order. The whole happy path typically finishes in well under a second locally, so this may already 404 (ended) by the time you run it - that's expected, move on to step 4."
					},
					"response": []
				},
				{
					"name": "4. Verify Final Order Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Order found\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"console.log(\"Final Order Status: \" + jsonData.status);",
									"",
									"if (jsonData.status === \"Shipped\") {",
									"    pm.test(\"Order shipped\", function () {",
									"        pm.expect(jsonData.status).to.eql(\"Shipped\");",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{order_url}}/api/orders/{{order_id}}",
							"host": [
								"{{order_url}}"
							],
							"path": [
								"api",
								"orders",
								"{{order_id}}"
							]
						},
						"description": "Step 4: Verify the final status of the order after the saga has run its course. Happy path ends with status Shipped; out-of-stock path ends with BackOrdered/Cancelled; unrecovered payment failure leaves it PaymentFailed."
					},
					"response": []
				}
			]
		}
	]
